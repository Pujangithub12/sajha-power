# Appwrite Storage (used for Disclosure document uploads)
# Create a project + bucket + API key at https://cloud.appwrite.io
# APPWRITE_ENDPOINT: your project's API endpoint, e.g. https://fra.cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID: found on your project's Settings page
# APPWRITE_API_KEY: a server API key with Storage read/write/delete scopes
# APPWRITE_BUCKET_ID: the bucket where disclosure documents are stored
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=

# Admin area (/admin/disclosure)
# ADMIN_EMAIL: the email address used to log in to the upload panel.
# ADMIN_PASSWORD_HASH: a bcrypt hash of the admin password (never store the raw password).
#   Generate one with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
#   IMPORTANT: bcrypt hashes contain literal $ characters (e.g. $2b$12$...), and Next.js's
#   env loader treats $NAME as variable expansion. Escape every $ as \$ in this file, e.g.
#   ADMIN_PASSWORD_HASH=\$2b\$12\$abcdefgh... — otherwise the hash gets silently truncated.
# SESSION_SECRET: a long random string used to sign the login session cookie.
#   Generate one with: openssl rand -hex 32
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
